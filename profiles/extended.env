# Perfil extended — referência 32 vCPU · 32 GB RAM · +1000 equipamentos, o
# maior porte: servidor dedicado ao recebimento de backup.
# 1600 portas passivas: libere a faixa no firewall do host, só para as redes
# de gerência, antes de subir. Exige pelo menos 16 CPUs no servidor.
FTP_MAX_CLIENTS=1200
FTP_MAX_CLIENTS_PER_IP=96
FTP_PASSIVE_PORT_START=30000
FTP_PASSIVE_PORT_END=31599
FTP_MEMORY_LIMIT=4G
FTP_CPU_LIMIT=16.0
FTP_PIDS_LIMIT=2048
FTP_NOFILE=262144
