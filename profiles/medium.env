# Perfil medium — referência 4 vCPU · 4 GB RAM · ~50 a ~200 equipamentos com
# janelas de backup parcialmente concorrentes (ex.: coleta noturna em lote).
# A faixa passiva cresce junto com FTP_MAX_CLIENTS — ajuste o firewall do host.
FTP_MAX_CLIENTS=120
FTP_MAX_CLIENTS_PER_IP=12
FTP_PASSIVE_PORT_START=30000
FTP_PASSIVE_PORT_END=30239
FTP_MEMORY_LIMIT=512M
FTP_CPU_LIMIT=2.0
FTP_PIDS_LIMIT=256
FTP_NOFILE=32768
