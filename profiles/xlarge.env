# Perfil xlarge — referência 16 vCPU · 16 GB RAM · +500 equipamentos ou vários
# coletores empurrando backup ao mesmo tempo, o dia todo.
# 800 portas passivas: libere a faixa no firewall do host, só para as redes
# de gerência, antes de subir.
FTP_MAX_CLIENTS=600
FTP_MAX_CLIENTS_PER_IP=48
FTP_PASSIVE_PORT_START=30000
FTP_PASSIVE_PORT_END=30799
FTP_MEMORY_LIMIT=2G
FTP_CPU_LIMIT=8.0
FTP_PIDS_LIMIT=1024
FTP_NOFILE=131072
