# Perfil small — referência 2 vCPU · 2 GB RAM · até ~50 equipamentos com
# janelas de backup NÃO concorrentes. Cobre a grande maioria dos provedores:
# backup de config é tráfego pequeno e esporádico.
# Confirme a capacidade real com o nº de sessões simultâneas do seu parque.
FTP_MAX_CLIENTS=50
FTP_MAX_CLIENTS_PER_IP=8
FTP_PASSIVE_PORT_START=30000
FTP_PASSIVE_PORT_END=30099
FTP_MEMORY_LIMIT=256M
FTP_CPU_LIMIT=1.0
FTP_PIDS_LIMIT=128
FTP_NOFILE=16384
