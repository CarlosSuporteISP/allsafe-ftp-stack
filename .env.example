TZ=America/Sao_Paulo
FTP_IMAGE=allsafe-ftp:local

# O bind local evita exposicao acidental. Troque pelo IP dedicado do servidor.
FTP_BIND_IP=127.0.0.1
FTP_PORT=21
FTP_PUBLIC_IP=127.0.0.1
FTP_PASSIVE_PORT_START=30000
FTP_PASSIVE_PORT_END=30049

FTP_USER=transfer
# Prefira deixar vazio e usar FTP_PASSWORD_FILE.
FTP_PASSWORD=
FTP_PASSWORD_FILE=/run/.secrets/ftp_password.txt

# 2 = TLS obrigatorio. Use 1 (opcional) apenas para legado conscientemente.
FTP_TLS_MODE=2
FTP_CERT_CN=ftp.exemplo.com.br
FTP_MAX_CLIENTS=50
FTP_MAX_CLIENTS_PER_IP=8

FTP_MEMORY_LIMIT=256M
FTP_CPU_LIMIT=1.0
FTP_PIDS_LIMIT=128
FTP_NOFILE=16384

# Sub-rede da rede Docker "ftp" (ftp). Troque só se colidir com a
# rede do cliente (LAN/VPN). Ex.: FTP_SUBNET=10.250.1.0/29
FTP_SUBNET=172.29.1.0/29
